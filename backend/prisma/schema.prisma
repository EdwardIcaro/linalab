  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([token])
  @@map("recuperacoes_senha")
}

// Regras de leitura de email → WhatsApp (motor genérico, config global do sistema).
// O bot lê as regras ativas, detecta emails que casam com remetente/assunto,
// extrai um valor via regex e envia o template no destino (grupo ou números).
model EmailRegra {
  id              String   @id @default(cuid())
  // empresaId/contaId são opcionais só durante a migração da automação global (Features/automacao-email.md §9)
  empresaId       String?
  contaId         String?
  nome            String
  ativo           Boolean  @default(true)
  remetenteContem String   // filtro por remetente (ex: "localiza")
  assuntoContem   String?  // filtro por assunto (opcional)
  // Corta email parecido do mesmo remetente: "Solicitação de Lavagem" casa dentro de
  // "Cancelamento Solicitação de Lavagem", e avisar lavagem de um serviço cancelado
  // mandaria alguém buscar um carro à toa.
  assuntoNaoContem String?
  regexExtracao   String   // ex: "seguir:[^0-9]{0,40}([0-9]{6})" — o 1º grupo vira {{valor}}
  // Informações além do valor principal: [{ chave, regex, opcional }] → {{chave}} no template
  campos          Json?
  // Linha que se repete (tabela de veículos): { regex, chaves, template } → {{itens}}
  bloco           Json?
  // Campos deduzidos de outro campo: [{ chave, de, valores, padrao }] — ex: preço → serviço,
  // porque o fornecedor parou de mandar o tipo de lavagem mas o preço ainda identifica qual é
  derivados       Json?
  // Campo que vem de fora do email: { de, chave, em, sufixo } — ex: modelo/cor do veículo
  // buscados pela placa no cadastro. Quem resolve é o poller (o extrator não toca no banco).
  enriquecer      Json?
  tipoValor       String   @default("AVANCADO") // CODIGO | ALFANUMERICO | VALOR | LINK | AVANCADO
  ancora          String?  // texto antes do valor — usado na explicação em português e na edição
  template        String   // ex: "🔑 Código Localiza: {{valor}}"
  destinos        Json?    // [{ "tipo": "ADMIN" | "BOT_USER", "id": "..." }] — IDs, nunca telefone
  destinoTipo     String   // LEGADO (automação global): "GRUPO" | "NUMEROS"
  destinoValor    String   // LEGADO: JID do grupo ou telefones separados por vírgula
  ultimoDisparoEm DateTime?
  totalDisparos   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  empresa         Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conta           EmailConta? @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([empresaId])
  @@map("email_regras")
}

// Conta de email do cliente (até 2 por empresa). A senha de app fica criptografada
// (AES-256-GCM, utils/credCrypto.ts) e NUNCA volta pro frontend.
model EmailConta {
  id                 String       @id @default(cuid())
  empresaId          String
  email              String
  senhaCriptografada String       // "v1:iv:tag:dados" — AAD = empresaId:contaId
  provedor           String       @default("GMAIL")
  status             String       @default("CONECTADO") // CONECTADO | ERRO | PAUSADO_PLANO
  ultimoErro         String?      // mensagem HUMANA (nunca o erro cru do IMAP)
  ultimoUid          Int?         // checkpoint do poller — sobrevive a restart
  uidValidity        String?
  verificadoEm       DateTime?
  criadoPor          String?      // usuarioId ou subaccountId
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  empresa            Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  regras             EmailRegra[]

  @@unique([empresaId, email])
  @@map("email_contas")
}

// Trava de dedup DURÁVEL pros crons de resumo (diário/semanal), que têm retry
// automático se o bot estiver offline no horário principal (ver whatsappNotificationService.ts).
// Precisa ser persistida no banco (não em memória) porque um deploy do backend no
// meio da janela de retry reinicia o processo e apagaria uma trava em memória —
// foi exatamente isso que causou o resumo diário duplicado em 16/09/2026 (deploy
// às 21:45, entre o envio das 20h e o retry das 22h).
model NotificacaoEnviada {
  id        String   @id @default(cuid())
  empresaId String
  tipo      String   // 'RESUMO_DIARIO' | 'RESUMO_SEMANAL'
  chave     String   // data (YYYY-MM-DD) do dia ou do sábado da semana
  createdAt DateTime @default(now())
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo, chave])
  @@map("notificacoes_enviadas")
}

// Quem recebe as automações de email. NÃO é admin do bot: não entra na lista de
// Usuários & Acesso e não recebe os avisos automáticos (resumo diário, caixa...).
// O admin da empresa monta essa lista dentro da própria automação.
model EmailDestinatario {
  id        String   @id @default(cuid())
  empresaId String
  nome      String
  telefone  String   // só dígitos, com DDI/DDD
  jid       String?  // JID real do WhatsApp (pode ser @lid), resolvido no cadastro
  ativo     Boolean  @default(true)
  criadoPor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, telefone])
  @@map("email_destinatarios")
}

// Fila de envio: o backend enfileira e o bot (PC local) consome e envia pelo número da Lina.
// Evita ter a chave de criptografia no PC e não depende do ngrok.
model WhatsappEnvio {
  id         String    @id @default(cuid())
  empresaId  String
  origem     String    // "EMAIL_AUTOMACAO"
  destino    String    // telefone/JID já resolvido e validado pelo backend
  texto      String    // zerado ("") depois de ENVIADO
  status     String    @default("PENDENTE") // PENDENTE | ENVIADO | ERRO
  tentativas Int       @default(0)
  erro       String?
  createdAt  DateTime  @default(now())
  enviadoEm  DateTime?
  empresa    Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("whatsapp_envios")
}

// Quem conectou/removeu conta e quem abriu a caixa de entrada — exigência da revisão de segurança
model EmailAutomacaoAuditoria {
  id        String   @id @default(cuid())
  empresaId String
  contaId   String?
  autorId   String
  acao      String   // CONTA_CRIADA | SENHA_TROCADA | CONTA_REMOVIDA | CONTA_VERIFICADA | EMAILS_LISTADOS | EMAIL_ABERTO | TESTE_ENVIO
  createdAt DateTime @default(now())
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, createdAt])
  @@map("email_automacao_auditoria")
}

// Log de eventos do sistema pro dono da plataforma (restart do bot, erros não
// tratados, perguntas que a Lina não conseguiu responder). Só o bot lê/escreve
// nela hoje — espelhada aqui pra manter os dois schema.prisma sincronizados.
model SystemEvent {
  id        String    @id @default(cuid())
  tipo      String // 'RESTART' | 'ERRO_USUARIO' | 'TOOL_FALHA' | ...
  mensagem  String
  contexto  Json?
  criadoEm  DateTime  @default(now())
  enviadoEm DateTime?

  @@index([tipo, enviadoEm])
  @@map("system_events")
}

// Relatório mensal de "Saúde Financeira" — gerado pelo cron do bot (dia 1),
// dados congelados no momento da geração. Espelhado aqui pro backend servir
// a página pública via token; expira em 7 dias, admin pode gerar um novo.
model RelatorioFinanceiroLink {
  id             String    @id @default(cuid())
  token          String    @unique
  empresaId      String
  mesReferencia  String    // "2026-08"
  entradas       Float
  saidas         Float
  saldo          Float
  entradasMesAnt Float
  saidasMesAnt   Float
  hp             Int
  categorias     Json      // [{ nome, valor }]
  lancamentos    Json      // [{ data, descricao, categoria, valor }]
  insightIA      String
  criadoEm       DateTime  @default(now())
  expiraEm       DateTime
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, mesReferencia])
  @@map("relatorio_financeiro_links")
}
