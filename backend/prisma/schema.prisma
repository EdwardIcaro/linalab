  nome            String
  telefone        String?
  tipoRemuneracao TipoRemuneracao  @default(COMISSAO)
  comissao        Float?           // % comissão padrão
  salario         Float?
  ativo           Boolean          @default(true)
  // Portal do funcionário (link curto + PIN, mesmo padrão do Lavador/DpFuncionario)
  pin             String?
  pinDefinido     Boolean          @default(false)
  sessionVersion  Int              @default(0)
  linkToken       String?          @unique
  // Vínculo opcional com Subaccount role USER — acesso ao portal via login normal
  usuarioId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
