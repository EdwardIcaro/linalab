model DpFuncionario {
  id                String       @id @default(cuid())
  empresaId         String
  nome              String
  cpf               String?
  cargo             String?
  salarioBase       Float?
  cargaHoraria      Int?         // horas por semana
  telefone          String?
  status            String       @default("ATIVO") // ATIVO | AFASTADO | FERIAS | DESLIGADO
  lavadorId         String?      // vínculo opcional com Lavador do Lina Wash
  usuarioId         String?      // vínculo opcional com Subaccount role USER
  jornadaEntrada    String?      // override individual: "08:00" (null = usa padrão da empresa)
  cargaHorariaDia   Float?       // override individual: 6.0 h/dia (null = usa padrão da empresa)
  dataAdmissao      DateTime?    // âncora do ciclo de 30 dias do banco de horas; null = usa createdAt como fallback
  cargoId           String?
  saldoBancoHorasAtual Float     @default(0) // cache do saldoAcumulado mais recente em DpFechamentoBanco
  pin               String?
  pinDefinido       Boolean      @default(false)
  sessionVersion    Int          @default(0)
  linkToken         String?      @unique
  wppJid            String?      @unique
  codigoWpp         String?
  codigoWppExpiraEm DateTime?
  pontoToken        String?      @unique
  pontoTokenExpiraEm DateTime?
  pontoTokenUsadoEm  DateTime?
  faceEmbedding     String?      // vetor 128D em JSON (null = facial não cadastrada)
  faceCapturadoEm   DateTime?    // data do enrollment — base para re-captura periódica
  faceToken         String?      @unique // token pessoal de cadastro do rosto (uso único)
  faceTokenExpiraEm DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  empresa           Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  marcacoes         DpMarcacao[]
  ajustes           DpAjuste[]
  afastamentos      DpAfastamento[]
  cargoRef          DpCargo?       @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  fechamentosBanco  DpFechamentoBanco[]
  assinaturas       DpEspelhoAssinatura[]
  movimentosBanco   DpBancoMovimento[]

  @@map("dp_funcionarios")
}

model DpMarcacao {
  id                  String        @id @default(cuid())
  empresaId           String
  funcionarioId       String
  tipo                String        // ENTRADA | SAIDA
  canal               String        // PWA | QR_CODE | WHATSAPP
  timestamp           DateTime      @default(now())
  lat                 Float?
  lng                 Float?
  gpsPrecisao         Float?
  gpsPrecisaoSuspeita Boolean       @default(false)
  gpsNegado           Boolean       @default(false)
  // Distância até a empresa no momento da batida, e se passou do raio permitido.
  // Gravadas SEMPRE que houver coordenada e endereço da empresa, inclusive nos níveis
  // que não bloqueiam: sem isso, uma batida feita longe não deixava rastro nenhum —
  // o cálculo existia, era usado para decidir o bloqueio e depois jogado fora.
  distanciaM          Int?
  foraDoRaio          Boolean       @default(false)
  faceScore           Float?        // confiança da verificação facial (null = não usou facial)
  ip                  String?
  ajustado            Boolean       @default(false)
  totemId             String?       // aparelho de onde veio a marcação (canal TOTEM)
  // Exclusão é lógica, nunca física: a batida sai da conta de horas mas continua
  // existindo, com quem tirou e quando. Registro de ponto apagado de verdade é prova
  // destruída — e o que sobra é a palavra do gestor contra a do funcionário.
  excluidaEm          DateTime?
  excluidaPor         String?
  createdAt           DateTime      @default(now())
  funcionario         DpFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  totem               DpTotem?      @relation(fields: [totemId], references: [id], onDelete: SetNull)
  logs                DpMarcacaoLog[]

  // Índice único que o Prisma não sabe declarar (usa expressão) e por isso vive só no SQL:
  //   UNIQUE ("funcionarioId", date_trunc('minute', "timestamp")) WHERE "timestamp" >= 2026-09-24
  // Barra duas batidas do mesmo funcionário no mesmo minuto — o duplo toque que o
  // cooldown da aplicação não pega quando os dois requests chegam juntos. É parcial
  // porque o histórico anterior tem 10 casos reais e apagar ponto passado seria pior.
  // Ver Features/sql-dp-marcacao-minuto.sql.
  @@map("dp_marcacoes")
}

// Histórico de toda intervenção humana ou automática numa marcação. Batida normal do
// funcionário não entra aqui — ela é o próprio registro. O que se guarda é o que foi
// mexido depois: lançamento manual do gestor, encerramento automático, edição, exclusão.
model DpMarcacaoLog {
  id              String     @id @default(cuid())
  empresaId       String
  marcacaoId      String
  funcionarioId   String
  acao            String     // CRIADA_MANUAL | CRIADA_AUTO | EDITADA | EXCLUIDA | RESTAURADA
  tipoAntes       String?
  timestampAntes  DateTime?
  tipoDepois      String?
  timestampDepois DateTime?
  autorNome       String     // nome de quem fez, ou "Sistema"
  autorId         String?    // subaccount ou usuário; nulo quando é o sistema
  motivo          String?
  createdAt       DateTime   @default(now())
  marcacao        DpMarcacao @relation(fields: [marcacaoId], references: [id], onDelete: Cascade)

  @@index([marcacaoId])
  @@index([empresaId, createdAt])
  @@map("dp_marcacoes_log")
}

// Ciência do funcionário sobre o espelho de um mês.
//
// Guarda o snapshot do que foi assinado e o hash dele: se qualquer batida daquele mês
// mudar depois, o hash do espelho atual deixa de bater com o assinado e o sistema pede
// nova assinatura. Sem unique por competência de propósito — cada assinatura é um
// evento, e a sequência delas é a prova de que houve mudança e nova ciência.
model DpEspelhoAssinatura {
  id            String        @id @default(cuid())
  empresaId     String
  funcionarioId String
  competencia   String        // "2026-09"
  hashConteudo  String        // SHA-256 do snapshot canônico
  conteudo      String        // o snapshot inteiro, como estava na hora da assinatura
  assinadoEm    DateTime      @default(now())
  origem        String        @default("PORTAL") // PORTAL | TOTEM
  faceScore     Float?        // confiança do reconhecimento, quando assinou no totem
  ip            String?
  userAgent     String?
  funcionario   DpFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId, competencia])
  @@map("dp_espelho_assinaturas")
}

// Cada fato que mexe no banco de horas de alguém. O saldo é a soma disto.
//
// Existe porque saldo sem extrato não se defende: na hora da rescisão ou da fiscalização,
// a pergunta não é "quanto ele tem", é "de onde veio e o que foi feito com cada hora".
model DpBancoMovimento {
  id            String        @id @default(cuid())
  empresaId     String
  funcionarioId String
  // CICLO      — fechamento de período (credita ou debita)
  // FOLGA_COMP — folga compensatória: o funcionário usou horas do banco
  // PAGAMENTO  — a empresa pagou as horas em dinheiro
  // VENCIMENTO — passou do prazo de compensação e virou hora extra devida
  // AJUSTE     — correção manual do gestor, sempre com motivo
  tipo          String
  horas         Float         // positivo credita, negativo debita
  data          String        // YYYY-MM-DD do fato
  descricao     String?
  fechamentoId  String?
  afastamentoId String?
  autorNome     String?
  saldoApos     Float
  createdAt     DateTime      @default(now())
  funcionario   DpFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId, data])
  @@index([empresaId, createdAt])
  @@map("dp_banco_movimentos")
}

model DpTotem {
  id          String       @id @default(cuid())
  empresaId   String
  nome        String       // rótulo dado pelo admin, ex: "Tablet recepção"
  token       String       @unique // pareamento permanente do aparelho
  ativo       Boolean      @default(true)
  ultimoUsoEm DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  marcacoes   DpMarcacao[]

  @@index([empresaId])
  @@map("dp_totens")
}

model DpAjuste {
