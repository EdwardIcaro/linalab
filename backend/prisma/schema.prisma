model DpFeriado {
  id         String   @id @default(cuid())
  empresaId  String
  data       String   // YYYY-MM-DD (se recorrente, só mês/dia importam pro match)
  nome       String
  // FECHADO = sem expediente (padrão). ABERTO = a empresa decidiu trabalhar no feriado,
  // e o dia volta a cobrar jornada normalmente.
  expediente  String   @default("FECHADO")
  recorrente Boolean  @default(false)
  createdAt  DateTime @default(now())
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

