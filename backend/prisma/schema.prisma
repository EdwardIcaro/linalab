  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  status      String   @default("pending_approval") // pending_approval | approved | rejected
  ip          String?
  userAgent   String?

  approvedBy  String?  // adminId que aprovou
  rejectedBy  String?  // adminId que rejeitou
  motivo      String?  // motivo da rejeição

