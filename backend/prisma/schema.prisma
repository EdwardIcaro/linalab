  tipo             String        // JUSTIFICAR_FALTA | CORRIGIR_HORA | OUTRO
  descricao        String        // motivo informado pelo funcionário
  status           String        @default("PENDENTE") // PENDENTE | APROVADO | REJEITADO
  obsGestor        String?       // resposta do gestor
  aprovadoPor      String?       // nome do gestor
  aprovadoEm       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  funcionario      DpFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@map("dp_ajustes")
}

model DpAfastamento {
  id               String        @id @default(cuid())
  empresaId        String
  funcionarioId    String
  tipo             String        // FERIAS | ATESTADO | LICENCA | FOLGA_COMP | OUTRO
  dataInicio       String        // YYYY-MM-DD
