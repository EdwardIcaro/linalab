  updatedAt DateTime         @updatedAt
  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  veiculos  LcVeiculo[]
  ordens    LcOrdemServico[]

  @@map("lc_clientes")
}

