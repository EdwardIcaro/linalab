  liniaOwnerId                String    @unique
  liniaOwner                  Usuario   @relation(fields: [liniaOwnerId], references: [id], onDelete: Cascade)

  whatsappNotificationPhone   String?   // "(11) 99999-8888" - formato brasileiro
  phoneConfirmed              Boolean   @default(false)
  phoneConfirmationToken      String?   @unique
  phoneConfirmationExpiresAt  DateTime?

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([liniaOwnerId])
