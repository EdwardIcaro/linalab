  @@unique([nome, empresaId])
  @@map("lc_funcionarios")
}

model LcServico {
  id                 String               @id @default(cuid())
  empresaId          String
  nome               String
  descricao          String?
  preco              Float
  comissaoPercentual Float?
  ativo              Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  empresa            Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordemItems         LcOrdemServicoItem[]

  @@map("lc_servicos")
}

model LcOrdemServico {
  id            String               @id @default(cuid())
  numeroOrdem   Int
  empresaId     String
  clienteId     String
  veiculoId     String?
  funcionarioId String?
  status        OrdemStatus          @default(PENDENTE)
  valorTotal    Float
  desconto      Float                @default(0)
  comissao      Float                @default(0)
  comissaoPaga  Boolean              @default(false)
  observacoes   String?
  dataInicio    DateTime?
  dataFim       DateTime?
  pago          Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  empresa       Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente       LcCliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo       LcVeiculo?           @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  funcionario   LcFuncionario?       @relation(fields: [funcionarioId], references: [id])
  items         LcOrdemServicoItem[]
  pagamentos    LcPagamento[]

  @@unique([empresaId, numeroOrdem])
  @@index([empresaId, status])
  @@index([empresaId, dataFim])
  @@map("lc_ordens_servico")
}

model LcOrdemServicoItem {
  id         String         @id @default(cuid())
  ordemId    String
  servicoId  String?
  nomeCustom String?        // nome do serviço avulso digitado na hora (quando não há servicoId)
  quantidade Int            @default(1)
  precoUnit  Float
  subtotal   Float
  createdAt  DateTime       @default(now())
  ordem      LcOrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  servico    LcServico?     @relation(fields: [servicoId], references: [id])

  @@index([ordemId])
  @@map("lc_ordens_servico_items")
}

model LcPagamento {
