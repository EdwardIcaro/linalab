model DpCargo {
  id              String          @id @default(cuid())
  empresaId       String
  nome            String
  cargaHorariaDia Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  funcionarios    DpFuncionario[]

  @@unique([nome, empresaId])
  @@map("dp_cargos")
}

model DpFechamentoBanco {
  id                     String        @id @default(cuid())
  empresaId              String
  funcionarioId          String
  periodoInicio          DateTime
  periodoFim             DateTime
  horasEsperadas         Float
  horasTrabalhadas       Float
  horasFeriadoTrabalhado Float         @default(0) // já incluso em horasTrabalhadas, peso ×2 (seção 7 da spec) — separado só pra auditoria
  diasFalta              Int           @default(0) // dias úteis sem batida — desconto em folha, fora do saldo
  saldoPeriodo           Float         // horasTrabalhadas - horasEsperadas (pode ser negativo)
  saldoAcumulado         Float         // saldo total do funcionário após esse fechamento
  fechadoEm              DateTime      @default(now())
  empresa                Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  funcionario            DpFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  // Um fechamento por ciclo, e só. Sem isso, duas execuções do cron (duas instâncias
  // do backend, ou uma re-execução manual) gravariam o mesmo período duas vezes e
  // dobrariam o saldo acumulado do funcionário — erro silencioso e difícil de desfazer.
  @@unique([funcionarioId, periodoInicio])
  @@index([funcionarioId, periodoFim])
  @@map("dp_fechamentos_banco")
}

// ─── LINA CENTER ─────────────────────────────────────────────────────────────
// Produto independente do ecossistema Lina (mesmo padrão do Data Point).
// Habilitado por empresa via EmpresaSistema (sistema: 'lina-center').
// Gestão para oficinas mecânicas / auto centers — versão simplificada do Lina Wash.

model LcCliente {
